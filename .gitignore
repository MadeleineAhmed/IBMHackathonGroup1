# Python bytecode / build
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# skore-cli credentials (Hub API key) - never commit
.skore

# virtual environments
.venv/

# competition data: raw Kaggle inputs stay local (everyone downloads their own).
# EDA outputs (data/eda.py, data/eda.md, data/eda_*.html) ARE committed.
data/*.csv
data/*.zip

# skore local Project store
reports/

# agent scratch space
scratch/

# generated Kaggle submission files
submission*.csv

# Jupyter: jupytext .py scripts are the source of truth
*.ipynb
.ipynb_checkpoints/

# OS / IDE
.DS_Store
*.swp
.vscode/
.idea/

# upstream lab repo clone (own git repo)
hackathon-upstream/
